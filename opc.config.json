{
  "schema": "opc-team/v2.21",
  "vault_root": "./OPC-Vault",
  "default_backend": "local",
  "backends": {
    "local": {
      "type": "local",
      "root": "./OPC-Vault",
      "note": "默认后端；所有产出留在 Vault 内"
    },
    "feishu": {
      "type": "exec",
      "label": "飞书 CLI / 自定义外部 CLI",
      "cli": "lark-cli",
      "push_cmd": "",
      "url_prefix": "",
      "folder_token": "",
      "project_prefix": "OPC",
      "base_token": "",
      "base_tables": {
        "项目汇总": "",
        "①需求池（关联项目）": "",
        "②版本开发计划": "",
        "③版本 Bug 记录": "",
        "发布版本": ""
      },
      "base_note": "多维表格台账地址（scripts/base_schema.py 用）。**app_token 与 table_id 是租户资源标识，发布物里一律留空** —— 填自己的表就填这里（本地副本），或用环境变量 FEISHU_BASE_TOKEN / FEISHU_BASE_TABLE_<KEY> 覆盖。未配置时 base_schema.py / base_clean.py 直接报错退出，不会去碰别人的表。表结构定义在 scripts/base_schema.py（那是真相源），本处只给地址。",
      "enabled": true,
      "credential_env": [
        "FEISHU_APP_ID",
        "FEISHU_APP_SECRET",
        "FEISHU_FOLDER_TOKEN"
      ],
      "note": "两种用法互不冲突。① 作**资产绑定后端**（§15.8）：把某岗位产出绑到飞书，opc bind <role> feishu --key <键> --ref <飞书地址>。② 作**远程仓库 / 云端仓库**（v2.7，默认）：本地照常写入，流程走完后额外把同一份产出再写一份到云端；此时用 opc sync。云端可沉淀知识库、产品原型、各项目任务与需求，创始人从云端查知识、拿未完成任务，回本地用 Agent 干活。sync_mode=auto（初始化时配了就不再逐次问）/ ask（每次问一次）/ off（不碰云端）。**上送分两类（v2.10 增量同步 + 远程写入权归 pm）**：① **各岗只本地入队，不直接写远程**——每个职业干完自己这步，用 opc done --sync-self 或 opc sync --role <本岗> 把本岗本次产出登记为待同步（批次号 + 时间戳 + SHA256 + 版本号），队列在 30_项目/_同步队列/；② **远程写入只有产品经理 pm 能做**——opc sync --flush 推送队列，或 opc sync --project <项目号> 做项目级全量；opc advance 推进时顺带推送本项目队列。**增量语义**：每个批次推到远端一个独立版本目录 OPC/<项目号>/<role>/<批次号>/，历史版本全部保留、互不覆盖，能看清产出演进轨迹。opc sync --queue 为纯本地只读（不需要 token）。云端不派活、不参与状态机、不做真相源，本地 Vault 始终是唯一真相源。folder_token 填云端根文件夹 token（可用 lark-cli drive +create-folder --name OPC 拿到）；未配置时同步静默跳过，不阻塞流程。",
      "sync_mode": "ask",
      "upload_by": "pm",
      "write_by": "pm",
      "sync_mode_note": "各岗只本地入队（--sync-self / --role）；远程写入由 pm 执行（--flush）。增量推送：每批次一个版本目录，历史保留不覆盖。",
      "remote_role": "repository",
      "remote_features": [
        "knowledge",
        "prototype",
        "tasks"
      ]
    },
    "yunxiao": {
      "type": "exec",
      "label": "阿里云云效（Codeup 代码仓库 / Flow CI-CD）",
      "cli": "",
      "push_cmd": "",
      "url_prefix": "",
