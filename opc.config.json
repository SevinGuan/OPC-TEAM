  "profiles_note": "换行业只换 profile：骨架（四层架构、owner/scope、简历回流、逻辑键→URI、脚本命令）行业无关，全部复用；每个 profile 只定义 step_docs（流程文档名）、step_owner（每步归属职业）、role_bindings（职业集合与产出键）、knowledge_domains（20_知识资产 子目录）、tags_vocab。新增行业 = 在 profiles 里加一段，不改脚本。app 自带手写岗位卡；其他 profile 缺卡时 init 自动生成九节骨架卡，由创始人 + Agent 在首个项目补全。",
  "internal_layers": {
    "L1": "local",
    "L3": "local",
    "L4": "local",
    "note": "骨架层 / 职业简历层 / 规则层建议始终本地，以保证双链、版本控制与一键回滚；仅 L2 产出层适合外部化"
  },
  "active_project": "",
  "active_project_note": "当前项目编号，由 opc new 自动写入；opc done / go / handoff 省略 --project 时一律取此值，创始人无需重复声明项目。",
  "notify": {
    "enabled": true,
    "channel": "local",
    "channels": {
      "local": {
        "type": "local",
        "file": "99_Agent配置/_交接通知.md",
        "note": "把交接通知追加进 Vault 内的人可读文件，零配置即可用"
      },
      "feishu": {
        "type": "exec",
        "cli": "python",
        "push_cmd": "python \"{vault}/99_Agent配置/通知桥/notify_feishu.py\" \"{file}\"",
        "credential_env": [
          "FEISHU_WEBHOOK_URL"
        ],
        "note": "开箱即用：init 会把通知桥脚本复制到 Vault 的 99_Agent配置/通知桥/。只需设置环境变量 FEISHU_WEBHOOK_URL 并把 notify.channel 改成 feishu；机器人开启签名校验时再设 FEISHU_WEBHOOK_SECRET（可选，不列入 credential_env 以免误判为必填）。企微/微信等 webhook 网关换脚本与 push_cmd 即可。凭证值绝不写入本文件；未配置或发送失败自动降级为 local，通知不丢。"
      },
      "dingtalk": {
        "type": "exec",
        "cli": "python",
        "push_cmd": "python \"{vault}/99_Agent配置/通知桥/notify_webhook.py\" \"{file}\" --kind dingtalk",
        "credential_env": [
          "DINGTALK_WEBHOOK_URL"
        ],
        "note": "钉钉群机器人 webhook。设置环境变量 DINGTALK_WEBHOOK_URL 后把 notify.channel 改为 dingtalk。"
      },
      "yunxiao": {
        "type": "exec",
        "cli": "python",
        "push_cmd": "python \"{vault}/99_Agent配置/通知桥/notify_webhook.py\" \"{file}\" --kind yunxiao",
        "credential_env": [
          "YUNXIAO_WEBHOOK_URL"
        ],
        "note": "云效（Codeup/Flow）webhook 网关。设置 YUNXIAO_WEBHOOK_URL 后把 notify.channel 改为 yunxiao；云效自带的流水线/代码事件通知仍在云效侧配置。"
      }
    },
    "state_path": "99_Agent配置/_交接状态.json",
    "gates": [
      0,
      2,
      7
    ],
    "gates_note": "闸门阶段必须创始人给出结论（通过/驳回/需补充），不能只回『继续』",
    "scope_note": "通知只发给创始人，不发给下游 Agent；下游由 step_docs 顺序推导，禁止跨步与指定。产出可为任意文件格式，用 opc done --file 一并登记。",
    "confirm_listener": {
      "enabled": false,
      "type": "feishu_ws",
      "start_cmd": "python scripts/opc.py listen --vault \"{vault}\"",
      "credential_env": [
        "FEISHU_APP_ID",
        "FEISHU_APP_SECRET"
      ],
      "optional_env": [
        "FEISHU_ALLOWED_OPEN_ID"
      ],
      "note": "可选常驻组件，只用于【收】创始人的自然语言确认，不用于【发】交接通知（发仍走 notify.channel）。基于飞书 SDK 的 WebSocket 长连接，仅企业自建应用，需订阅 im.message.receive_v1 并在后台选择「使用长连接接收事件」；凭证值只走环境变量。未启用或依赖缺失时降级为在当前会话里说一句『继续』，由当前会话代为执行 opc go。"
    },
    "dispatch": {
      "enabled": true,
      "founder_id_env": "FEISHU_FOUNDER_UNION_ID",
      "profile_root": "~/.hermes/profiles",
      "app_id_env": "FEISHU_APP_ID",
      "app_secret_env": "FEISHU_APP_SECRET",
      "note": "v2.27：mode=group → 角色在群里 @ 创始人（唤醒零 @）；mode=dm → 私聊。chat_id 填群 ID（公开标识，不是凭证）。创始人交互时 @ 该角色 —— require_mention=true 保证只有被 @ 的角色醒。凭证与 union_id 只走环境变量，不入库。",
      "mode": "group",
      "chat_id": ""
    }
  },
  "agent_mode": "single",
  "agent_mode_note": "single=单个 Bot 按岗位卡切换身份（默认，任何支持自定义提示词的 Agent 产品都能跑）；multi=每个职业一个独立 Bot（需宿主支持多 Bot 且需手动创建）",
  "index_path": "30_项目/_产出索引.md",
  "security": {
    "credentials_in_config": false,
    "credentials_source": "environment_variables_only",
    "note": "永远不要把 app_secret / token 写入本文件、简历或任何入库文档"
  },
  "tools": {
    "registry_path": "99_Agent配置/工具注册表.md",
    "project_config_name": "_工具配置.md",
    "registry_version": "v1.9",
    "require_approval_for_registry": true,
    "credential_policy": "env_only",
    "note": "全局注册表仅创始人经 opc tools promote --approve 可写；Agent 只读。项目层每项目一份、只增不改、随项目归档。凭证只存环境变量名，API Key 值与 MCP server 配置留在宿主。 首批 22 项出厂预置于 2026-11-12 联网核实并经创始人确认。"
  }
